  "verification_schema": {
    "per_scene_fields": {
      "original_filename": "Original TIFF/SLC filename from the official release (string, null until audited)",
      "parent_scene_id": "Official source scene/product identifier (string, null until audited)",
      "chip_coords": "[x, y, width, height] of the chip within the parent scene (list, null until audited)",
      "acquisition_date": "SAR acquisition date YYYY-MM-DD (string, null until audited)",
      "sha256": "SHA-256 checksum of the original image file (string, null until audited)",
      "sensor_verified": "Whether the sensor was confirmed from annotation metadata (bool, false until audited)"
    },
    "audit_script": "results/audit_scene_provenance.py",
    "audit_instructions": [
      "1. Download the official SSDD and RSDD datasets",
      "2. Run: python results/audit_scene_provenance.py --ssdd-dir <path> --rsdd-dir <path>",
      "3. The script computes SHA-256 for every image, extracts chip coordinates,",
      "   verifies sensor assignments, and writes the populated map to",
      "   results/scene_sensor_slice_map_audited.json",
      "4. Cross-check: no two chips from different splits should overlap by >50%",
      "5. Report any sensor mislabeling or inter-split overlap"
    ]
  }
